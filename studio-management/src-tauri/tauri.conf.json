{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Studio Management System",
  "version": "1.0.1",
  "identifier": "com.mayur.studio",

  "build": {
    "frontendDist": "../dist/studio-management-system/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "title": "Studio Management System",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}